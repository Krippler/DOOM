# Keep the build context small and make sure no game data is ever baked in.
.git
.gitignore
*.wad
*.WAD
wads/

# ...except the shareware IWAD, which id distributes freely and which
# ships in the image so the game runs with nothing mounted.
!shareware/doom1.wad
linuxdoom-1.10/linux/
linuxdoom-1.10/CVS/
sndserv/linux/
audiostream/linux/
videostream/linux/
ipx/
sersrc/
*.o
*.pcx
doomsav*.dsg
DOCKER.md
PORTING-NOTES.md
PUBLISHING.md
CHANGELOG.md
docker-compose.yml
templates/
ca_profile.xml
.github/
